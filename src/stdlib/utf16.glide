// UTF-16 interop for APIs such as Win32 MessageBoxW. Glide strings remain
// UTF-8; WideString owns a temporary, NUL-terminated u16 buffer.

/// An owning UTF-16 buffer suitable for Win32 `LPCWSTR` parameters.
/// `len` counts code units before the final NUL. Release it with `.free()`.
pub struct WideString {
    pub data: *u16,
    pub len: i32,
}

impl WideString {
    /// Convert a Glide UTF-8 string into NUL-terminated UTF-16. Invalid
    /// Unicode scalar values become U+FFFD; embedded NUL is rejected because
    /// it would truncate the text seen by a Win32 wide-string API.
    ///
    /// ```glide
    /// let wide: *WideString = WideString::from_utf8("Olá 👋")?;
    /// defer wide.free();
    /// // pass wide.as_ptr() to a Win32 function expecting LPCWSTR
    /// ```
    pub fn from_utf8(s: string) -> !*WideString {
        let cps: *Vector<i32> = s.chars();
        defer cps.free();
        for let i: i32 = 0; i < cps.len(); i++ {
            if cps.get(i) == 0 { return err("UTF-16 string contains an embedded NUL"); }
        }

        // A Unicode scalar needs at most as many UTF-16 code units as its
        // UTF-8 byte sequence, so byte length plus terminator is sufficient.
        let data: *u16 = malloc((s.len() + 1) * sizeof(u16)) as *u16;
        if data == null { return err("out of memory converting to UTF-16"); }
        let mut n: i32 = 0;
        for let i: i32 = 0; i < cps.len(); i++ {
            let mut cp: i32 = cps.get(i);
            if cp < 0 || cp > 1114111 || cp >= 55296 && cp <= 57343 {
                cp = 65533;
            }
            if cp <= 65535 {
                data[n] = cp as u16;
                n = n + 1;
            } else {
                let v: i32 = cp - 65536;
                data[n] = (55296 + (v >> 10)) as u16;
                data[n + 1] = (56320 + (v & 1023)) as u16;
                n = n + 2;
            }
        }
        data[n] = 0 as u16;

        let wide: *WideString = malloc(sizeof(WideString)) as *WideString;
        if wide == null {
            free(data as *void);
            return err("out of memory converting to UTF-16");
        }
        wide.data = data;
        wide.len = n;
        return ok(wide);
    }

    /// Pointer to the NUL-terminated code units. Valid until `.free()`.
    pub fn as_ptr(self) -> *u16 {
        return self.data;
    }

    /// Release the code units and the wrapper.
    pub fn free(self) {
        free(self.data as *void);
        free(self as *void);
    }
}
